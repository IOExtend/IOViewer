<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>IOViewer</PackageId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DefaultItemExcludes>$(DefaultItemExcludes);Viewer/node_modules/**</DefaultItemExcludes>
    <!-- The IOScene range ends at 0.2.0-0, a prerelease bound, which pack reports as NU5104. -->
    <NoWarn>$(NoWarn);NU5104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="IOScene" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="IOViewer.Tests" />
    <InternalsVisibleTo Include="IOViewer.Cli" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Viewer/index.html" LogicalName="IOViewer.Viewer.index.html" />
    <EmbeddedResource Include="Viewer/dist/viewer.js" LogicalName="IOViewer.Viewer.viewer.js" />
    <EmbeddedResource Include="Viewer/styles/viewer.css" LogicalName="IOViewer.Viewer.viewer.css" />
  </ItemGroup>

</Project>
