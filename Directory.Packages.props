<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Patch = adds or fixes, minor = breaking while IOScene is 0.x; the -0.0 keeps out previews of the next breaking line
         (nuget.org refuses the shorter bound -0 in a dependency). -->
    <PackageVersion Include="IOScene" Version="[0.1.0, 0.2.0-0.0)" />
    <PackageVersion Include="IfcIO.Scene" Version="0.11.1" />
    <PackageVersion Include="RvtIO.Scene" Version="0.4.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>
