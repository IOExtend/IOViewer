{
  "metadata": [
    {
      "src": [
        { "src": "src/IOViewer", "files": ["IOViewer.csproj"] }
      ],
      "dest": "docs/api",
      "properties": { "TargetFramework": "net10.0" },
      "outputFormat": "apiPage"
    }
  ],
  "build": {
    "content": [
      { "src": "docs", "files": ["*.md", "toc.yml", "api/**/*.yml", "api/**/*.md"] }
    ],
    "resource": [
      { "src": "docs", "files": ["images/**"] }
    ],
    "output": "_site",
    "globalMetadata": {
      "_appTitle": "IOViewer",
      "_appFooter": "IOViewer is licensed under the MIT License.",
      "_appLogoPath": "images/ioviewer-logo.svg",
      "_appFaviconPath": "images/favicon.ico",
      "_enableSearch": true
    },
    "template": ["default", "modern", "templates/ioviewer"]
  }
}
