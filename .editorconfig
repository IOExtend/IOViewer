root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.cs]
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_prefer_primary_constructors = false
dotnet_diagnostic.CA1848.severity = none

[*.{yml,yaml}]
indent_size = 2
